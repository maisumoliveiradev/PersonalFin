{
  "name": "@personalfin/api",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env src/database/migrate-cli.ts",
    "auth:schema": "node --env-file-if-exists=.env src/auth/print-auth-schema.ts",
    "test:integration": "node --env-file-if-exists=.env ../../node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.5",
    "@fastify/cors": "11.3.0",
    "@personalfin/api-contract": "*",
    "@personalfin/domain": "*",
    "better-auth": "1.7.5",
    "csv-parse": "7.0.3",
    "fastify": "5.12.5",
    "pdfkit": "0.20.2",
    "pg": "8.23.0",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1"
  }
}
